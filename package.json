{
  "name": "beauty-wellness-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev:local": "node scripts/local-development.mjs serve",
    "dev:stop": "node scripts/local-development.mjs stop",
    "dev:status": "node scripts/local-development.mjs status",
    "dev:owner": "node scripts/local-development.mjs owner",
    "dev:access": "node scripts/local-development.mjs access",
    "dev:sector": "node scripts/local-development.mjs sector",
    "dev:commercial": "node scripts/local-development.mjs commercial",
    "env:setup": "node scripts/setup-env.mjs",
    "dev:setup": "pnpm env:setup && pnpm install --frozen-lockfile --store-dir .pnpm-store && pnpm db:up && pnpm db:check && pnpm prisma:validate && pnpm prisma:generate && pnpm db:migrate && pnpm db:migrate:status",
    "dev": "pnpm -r --parallel --stream run dev",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "lint": "eslint scripts eslint.config.mjs --max-warnings=0 && pnpm -r run lint && pnpm format:check",
    "test": "pnpm test:scripts && pnpm -r --workspace-concurrency=1 run test",
    "test:scripts": "node --test scripts/dev-runtime.test.mjs",
    "test:oidc": "node --test scripts/oidc-protocol.test.mjs",
    "test:dev-processes": "node --test scripts/dev-runtime.integration.test.mjs",
    "typecheck": "pnpm -r run typecheck",
    "db:up": "docker compose up -d --wait postgres",
    "db:status": "docker compose --profile test ps --all",
    "db:check": "node scripts/check-db.mjs",
    "db:stop": "docker compose --profile test stop",
    "db:test:up": "docker compose --profile test up -d --wait postgres-test",
    "prisma:validate": "pnpm --filter @beauty-wellness/api prisma:validate",
    "prisma:generate": "pnpm --filter @beauty-wellness/api prisma:generate",
    "db:migrate": "pnpm --filter @beauty-wellness/api prisma:migrate:deploy",
    "db:migrate:dev": "pnpm --filter @beauty-wellness/api prisma:migrate:dev",
    "db:migrate:status": "pnpm --filter @beauty-wellness/api prisma:migrate:status",
    "test:integration": "pnpm --filter @beauty-wellness/api test:integration",
    "verify": "pnpm prisma:validate && pnpm prisma:generate && pnpm db:up && pnpm db:check && pnpm db:migrate:status && pnpm db:test:up && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build && pnpm test:oidc",
    "health": "node scripts/check-health.mjs",
    "format:check": "prettier --check apps scripts package.json pnpm-workspace.yaml compose.yaml eslint.config.mjs README.md",
    "format": "prettier --write apps scripts package.json pnpm-workspace.yaml compose.yaml eslint.config.mjs README.md",
    "control:bootstrap": "pnpm --filter @beauty-wellness/api control:bootstrap"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
