NODE_ENV=development
# Acceso web local cerrado por defecto. Opt-in temporal mediante pnpm dev:local.
LOCAL_ACCESS_ENABLED=false
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://bw_local:local_dev_only@127.0.0.1:55432/beauty_wellness_dev?schema=public
# Server-only managed OIDC. Disabled until a real Auth0 application is configured.
COMMERCIAL_AUTH_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
# 32 random bytes encoded as 64 hex characters. Never VITE_ or committed.
COMMERCIAL_STATE_KEY=
# Separate least-privilege M2M app: only update:users, used to request verification.
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
